PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=your_supabase_project_url
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Admin PIN — server-side secret for /api/admin/* endpoints.
# This value is NEVER exposed to the frontend.
ADMIN_PIN=your_admin_pin

# Session signing secret — used to sign admin session cookies.
# Generate a strong random value (e.g. openssl rand -hex 32).
# Must be set in production; the server will refuse admin logins without it.
ADMIN_SESSION_SECRET=your_session_secret
