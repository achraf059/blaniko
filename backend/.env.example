PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin PIN — server-side secret for /api/admin/* endpoints.
# This value is NEVER exposed to the frontend.
# Do NOT set VITE_ADMIN_PIN to the same value as ADMIN_PIN.
# ADMIN_PIN is the real security gate (checked server-side on every request).
# VITE_ADMIN_PIN, if used, is only a frontend UI convenience gate and provides
# no backend protection — an attacker can bypass it entirely.
ADMIN_PIN=your_admin_pin
