PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin PIN — server-side gate for /api/admin/* endpoints
# Must match VITE_ADMIN_PIN in frontend/.env.local
# VITE_ADMIN_PIN controls the frontend UI gate (client-side only, not real security)
# ADMIN_PIN controls the backend API gate (server-side — actual protection)
ADMIN_PIN=your_admin_pin
